# Windows batch files are stored with CRLF line endings (cmd.exe misreads
# labels and goto in LF-only files), also for ZIP downloads, so git must not
# convert them.
*.bat -text
*.cmd -text
apps/studio/src/steps.generated.json text eol=lf linguist-generated
docs/workflow.schema.json text eol=lf linguist-generated
docs/STEP_REFERENCE.md text eol=lf linguist-generated
